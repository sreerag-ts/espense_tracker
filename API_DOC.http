Content-Type: application/json
Authorization: Basic admin:admin@123

{
    "title":"fuel bike",
    "amount":20000,
    "category":"fuel"
}

#api call for fetching expense details
###
GET http://127.0.0.1:8000/expense/1/
Accept: application/json
Authorization: Basic admin:admin@123



#api call for ,updating expense details
###
PUT  http://127.0.0.1:8000/expense/1/
Content-Type: application/json
Authorization: Basic admin:admin@123

{
  "id": 1,
  "title": "snaks",
  "category": "food",
